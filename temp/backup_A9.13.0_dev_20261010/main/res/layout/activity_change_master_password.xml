<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootChangeMasterScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_master_title"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/etCurrentMaster"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:hint="@string/change_master_current"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etNewMaster"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/change_master_new"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etConfirmMaster"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/change_master_confirm"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColorHint="@color/text_hint" />

            <TextView
                android:id="@+id/tvChangeMasterHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/change_master_note"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbChangeMaster"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnChangeMasterOk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/change_master_ok"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnChangeMasterCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:text="@string/cancel"
            android:textColor="@color/primary"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
