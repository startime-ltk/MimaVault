<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- A9.14.0：仅更新通道联网，数据不上传 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MimaVaultApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MimaVault"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.UnlockActivity"
            android:exported="true"
            android:theme="@style/Theme.MimaVault.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.GlobalSearchActivity" android:exported="false" />
        <activity android:name=".ui.EditEntryActivity" android:exported="false" />
        <activity android:name=".ui.DetailActivity" android:exported="false" />
        <activity android:name=".ui.GestureActivity" android:exported="false" />
        <activity android:name=".ui.QrExportActivity" android:exported="false" />
        <activity android:name=".ui.QrImportActivity" android:exported="false" />
        <activity android:name=".ui.TrashActivity" android:exported="false" />
        <activity android:name=".ui.SecurityReportActivity" android:exported="false" />
        <activity android:name=".ui.PasswordHistoryActivity" android:exported="false" />
        <activity android:name=".ui.ChangeMasterPasswordActivity" android:exported="false" />

        <!-- A9.14.0：更新安装包经 FileProvider 提供给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
