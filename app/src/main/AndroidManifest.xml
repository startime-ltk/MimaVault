<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".MimaVaultApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MimaVault"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.UnlockActivity"
            android:exported="true"
            android:theme="@style/Theme.MimaVault.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.EditEntryActivity" android:exported="false" />
        <activity android:name=".ui.DetailActivity" android:exported="false" />
        <activity android:name=".ui.GestureActivity" android:exported="false" />
        <activity android:name=".ui.FaceActivity" android:exported="false" />
        <activity android:name=".ui.QrExportActivity" android:exported="false" />
        <activity android:name=".ui.QrImportActivity" android:exported="false" />
        <activity android:name=".ui.TrashActivity" android:exported="false" />
        <activity android:name=".ui.SecurityReportActivity" android:exported="false" />
    </application>

</manifest>
