<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="460dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbRandom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/gen_mode_random"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbPassphrase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gen_mode_passphrase"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- 随机密码参数 -->
        <LinearLayout
            android:id="@+id/panelRandom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLengthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="32"
                android:progress="8" />

            <CheckBox
                android:id="@+id/cbExcludeAmbiguous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/gen_exclude_ambiguous"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/gen_types"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbUpper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/gen_upper"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbLower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/gen_lower"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbDigits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/gen_digits"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbSymbols"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/gen_symbols"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etCustomCharset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/gen_custom_charset_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 口令短语参数 -->
        <LinearLayout
            android:id="@+id/panelPassphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWordsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="8"
                android:progress="2" />

            <EditText
                android:id="@+id/etSeparator"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="@string/gen_separator_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbCapitalize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gen_capitalize"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbAppendNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gen_append_number"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCustomWords"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="@string/gen_custom_words_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/text_main"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRegen"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:text="@string/gen_regen"
            android:textColor="@color/primary"
            android:textSize="13sp"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
